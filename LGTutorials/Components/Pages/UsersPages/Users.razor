@page "/Users";
@using LGTutorials.Models



<h3>Users</h3>


<a href="/addUsers">Add Users</a>

<EditForm Model="game" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText @bind-Value="game.Title" />
    <ValidationMessage For="() => game.Title" />

    <InputNumber @bind-Value="game.Year" />

    <button type="submit">Add</button>
</EditForm>

<button @onclick="Clear">Clear</button>

@if (ok)
{
    <div>
        Title: @game.Title, Year: @game.Year
    </div>
}

@foreach (var g in games)
{
    <GameCard Game="g" OnRemove="RemoveGame" />
}

<ItemList Items="games">
    <ItemTemplate Context="g">
        <strong>@g.Title</strong> (@g.Year)
    </ItemTemplate>
    <EmptyContent>
        <p>No games yet.</p>
    </EmptyContent>
</ItemList>




@code {

    bool ok = false;
    private GameSuggestion game = new();
    private List<GameSuggestion> games = new();

    private void Submit()
    {
        games.Add(game);
        game = new();   // reset the form

        Console.WriteLine($"Title: {game.Title}, Year: {game.Year}");
        ok = true;
    }
  
    private void Clear()    {

        game = new();
        ok = false;
    }

    private void RemoveGame(GameSuggestion g)
    {
        games.Remove(g);
    }
}